{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "config/wsgi.py" },
    { "src": "/admin/(.*)", "dest": "config/wsgi.py" },
    { "src": "/media/(.*)", "dest": "config/wsgi.py" },
    { "src": "/static/(.*)", "dest": "config/wsgi.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "frontend/dist/index.html" }
  ]
}